# ==============================================================================
# FocusBridge Frontend Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to create your local environment file:
#      cp .env.example .env.local
# 2. Adjust values below if your backend runs on a custom host or port.
# 3. NEVER commit .env.local or real secrets to Git.
# ==============================================================================

# Backend API Root URL
# Must include the '/api' prefix and point to the running Express backend.
# Defaults to: http://localhost:4000/api
NEXT_PUBLIC_API_URL=http://localhost:4000/api
