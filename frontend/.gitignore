# ==============================================================================
# FocusBridge Frontend .gitignore
# ==============================================================================

# Dependencies
node_modules/
/.pnp
.pnp.js

# Environment Variables & Secrets (STRICTLY FORBIDDEN FROM COMMITS)
.env
.env.*
.env.local
.env.*.local
.env.development
.env.test
.env.production
.env.staging
*.env
*.env.*
# Allow safe template files
!.env.example
!*.env.example

# Next.js Build Outputs
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# Testing & Coverage
coverage/
.nyc_output/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS-generated files
.DS_Store
Thumbs.db

# IDE & Editor directories
.vscode/
.idea/
*.swp
*~

# Backups & Temporary files
*.bak
*.backup
*.tmp
