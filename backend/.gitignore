# ==============================================================================
# FocusBridge Backend .gitignore
# ==============================================================================

# Dependencies
node_modules/

# Environment Variables & Secrets (STRICTLY FORBIDDEN FROM COMMITS)
.env
.env.*
.env.local
.env.*.local
.env.development
.env.test
.env.production
.env.staging
*.env
*.env.*
# Allow safe template files
!.env.example
!*.env.example

# Build and runtime outputs
dist/
build/

# Testing & Coverage
coverage/
.nyc_output/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS-generated files
.DS_Store
Thumbs.db

# IDE & Editor directories
.vscode/
.idea/
*.swp
*~

# Databases & Backups
*.sqlite
*.sqlite3
*.db
*.bak
*.backup
