# ==============================================================================
# FocusBridge Backend Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to create your local environment file:
#      cp .env.example .env
# 2. Fill in or adjust values below for your local environment.
# 3. NEVER commit the real .env file or real secrets to Git.
# ==============================================================================

# Server Environment
# Options: development, production, test
# Defaults to: development
NODE_ENV=development

# Backend HTTP Server Port
# Defaults to: 4000
PORT=4000

# MongoDB Connection String
# In development, if a local MongoDB instance is not detected, an isolated in-memory
# MongoDB server starts automatically for seamless local onboarding.
# For local MongoDB: mongodb://127.0.0.1:27017/focusbridge
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/focusbridge?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/focusbridge

# JWT Authentication Secret
# REQUIRED in production. In development, a generic fallback is provided if left blank.
# To generate a cryptographically strong 48-byte hex secret, run:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your-secure-jwt-secret-here-min-32-chars

# JWT Session Expiration
# Standard time string (e.g., 12h, 1d, 7d). Defaults to: 12h
JWT_EXPIRES_IN=12h

# Frontend Client URL (for CORS and Cookie Security)
# Used to authorize cross-origin requests from the Next.js frontend.
# Defaults to: http://localhost:3000
CLIENT_URL=http://localhost:3000

# Demo Seed Password (Optional, Development Only)
# Password assigned to all seeded demo accounts when running: npm run seed
# Defaults to: DemoPass123
SEED_PASSWORD=DemoPass123

# AI Provider API Key (Optional)
# Google Gemini API key for AI-assisted study planning and schedule breakdown.
# If left blank, FocusBridge automatically uses the built-in deterministic rule-based planner.
AI_API_KEY=

# AI Model Identifier (Optional)
# Defaults to: gemini-2.0-flash
AI_MODEL=gemini-2.0-flash

# Background Jobs Interval (Optional)
# Frequency in minutes for the background notification and reminder job loop.
# Defaults to: 15
JOBS_INTERVAL_MINUTES=15

# Integration Test Database URI (Optional)
# Only needed if you wish to run tests against a persistent database.
# Defaults to isolated in-memory MongoMemoryServer.
MONGODB_TEST_URI=
