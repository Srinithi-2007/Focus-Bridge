# ==============================================================================
# FocusBridge Root Environment Configuration Reference
# ==============================================================================
# FocusBridge is structured as a decoupled full-stack application:
#   - Backend: Express.js + Mongoose (in ./backend)
#   - Frontend: Next.js 15 App Router + Tailwind CSS (in ./frontend)
#
# To configure each component, copy its respective example file:
#   Backend:  backend/.env.example  -->  backend/.env
#   Frontend: frontend/.env.example -->  frontend/.env.local
#
# NOTE: Real .env files are strictly excluded from version control via .gitignore.
# Never commit real secrets, API keys, or database credentials.
# ==============================================================================

# BACKEND CONFIGURATION (backend/.env):
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/focusbridge
JWT_SECRET=your-secure-jwt-secret-here-min-32-chars
JWT_EXPIRES_IN=12h
CLIENT_URL=http://localhost:3000
SEED_PASSWORD=DemoPass123
AI_API_KEY=
AI_MODEL=gemini-2.0-flash
JOBS_INTERVAL_MINUTES=15

# Transactional Email Provider (resend / smtp):
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=FocusBridge <notifications@focusbridge.app>
APP_BASE_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# FRONTEND CONFIGURATION (frontend/.env.local):
NEXT_PUBLIC_API_URL=http://localhost:4000/api
